From 24dff9b524090fd7162e1a7dbb6a3e1c35af2a79 Mon Sep 17 00:00:00 2001
From: nixos-config <nixos-config@local>
Date: Sun, 1 Nov 2026 18:30:13 -0300
Subject: [PATCH 1/3] fix: skip cursor-hidden check while wiggling on mutter-17

On mutter-17+ (GNOME 49+) hiding the cursor makes get_sprite() return
null, so _checkCursorHiddenByProgram() would misfire mid-wiggle:
force-unmagnify, remove the pointer watch and clear history.

Skip the sprite check while isWiggling is true.
---
 extension.js | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/extension.js b/extension.js
index 9241933..0b430aa 100644
--- a/extension.js
+++ b/extension.js
@@ -48,6 +48,13 @@ export default class WigglyExtension extends Extension {
     }
 
     _checkCursorHiddenByProgram() {
+        // While wiggling we hide the cursor ourselves. On mutter-17+
+        // (GNOME 49+) hiding the cursor makes get_sprite() return null, so
+        // the check below would misfire, force-unmagnify immediately and
+        // tear down the pointer watch mid-wiggle.
+        if (this._effect.isWiggling) {
+            return false;
+        }
         // different program might take other methods to hide the cursor, so this check should contain more conditions
         if (!this._effect.cursor.sprite) {
             if (!this._isHiddenByProgram) {
