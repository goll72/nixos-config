diff --git a/src/privilege.c b/src/privilege.c
new file mode 100644
index 0000000..17bec2f
--- /dev/null
+++ b/src/privilege.c
@@ -0,0 +1,316 @@
+#include "seekey.h"
+#include "privilege.h"
+
+#include <errno.h>
+#include <grp.h>
+#include <limits.h>
+#include <pwd.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+/* Internal argument used to carry session environment values across the
+ * pkexec boundary.  pkexec runs its target with a sanitized environment
+ * (no WAYLAND_DISPLAY, no XDG_RUNTIME_DIR, no D-Bus address), which would
+ * leave the GUI unable to start.  The values are stripped from argv while
+ * still root and applied only after the process dropped back to the
+ * invoking user, so attacker-controlled input is never consumed with root
+ * privileges.  See POLKIT.md. */
+#define RESTORE_ARG_PREFIX "--seekey-restore-env="
+
+/* Environment variables that may be carried across the pkexec boundary.
+ * Anything not on this list is discarded. */
+static const char *const restore_env_keys[] = {
+    "WAYLAND_DISPLAY",
+    "WAYLAND_SOCKET",
+    "DBUS_SESSION_BUS_ADDRESS",
+    "DISPLAY",
+    "XAUTHORITY",
+    "XDG_RUNTIME_DIR",
+    "XDG_CONFIG_HOME",
+    "XDG_DATA_HOME",
+    "XDG_DATA_DIRS",
+    "XDG_STATE_HOME",
+    "XDG_CACHE_HOME",
+    "XDG_CURRENT_DESKTOP",
+    "XDG_SESSION_TYPE",
+    "XDG_SESSION_DESKTOP",
+    "XDG_ACTIVATION_TOKEN",
+    "GDK_BACKEND",
+    "GDK_RENDERING_ENVIRONMENT",
+    "TERM",
+    "COLORTERM",
+    NULL,
+};
+
+/* Set once this process went through seekey_privilege_drop_from_pkexec().
+ * Prevents any attempt to elevate again (and pkexec recursion). */
+static gboolean privilege_dropped = FALSE;
+
+gboolean seekey_privilege_elevated(void)
+{
+    return privilege_dropped;
+}
+
+gboolean seekey_privilege_env_key_allowed(const char *key)
+{
+    if (key == NULL) {
+        return FALSE;
+    }
+    for (gsize i = 0; restore_env_keys[i] != NULL; i++) {
+        if (g_strcmp0(restore_env_keys[i], key) == 0) {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+GPtrArray *seekey_privilege_strip_restore_args(int *argc, char ***argv)
+{
+    GPtrArray *pairs = g_ptr_array_new_with_free_func(g_free);
+    int out = 1; /* argv[0] is never touched */
+
+    for (int i = 1; i < *argc; i++) {
+        char *arg = (*argv)[i];
+        if (g_str_has_prefix(arg, RESTORE_ARG_PREFIX)) {
+            const char *pair = arg + strlen(RESTORE_ARG_PREFIX);
+            const char *eq = strchr(pair, '=');
+            if (eq != NULL && eq != pair) {
+                g_ptr_array_add(pairs, g_strdup(pair));
+            }
+            /* Malformed entries are dropped, never parsed. */
+            continue;
+        }
+        (*argv)[out++] = arg;
+    }
+    for (int i = out; i < *argc; i++) {
+        (*argv)[i] = NULL;
+    }
+    *argc = out;
+    return pairs;
+}
+
+gboolean seekey_privilege_drop_from_pkexec(int *argc, char ***argv,
+                                           GError **error)
+{
+    const char *pkexec_uid = g_getenv("PKEXEC_UID");
+    if (geteuid() != 0 || pkexec_uid == NULL) {
+        return TRUE;
+    }
+
+    GPtrArray *pairs = seekey_privilege_strip_restore_args(argc, argv);
+
+    char *end = NULL;
+    errno = 0;
+    unsigned long uid_ul = strtoul(pkexec_uid, &end, 10);
+    if (errno != 0 || end == pkexec_uid || *end != '\0' ||
+        (unsigned long)(uid_t)uid_ul != uid_ul) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                            _("invalid user id passed by pkexec"));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+    uid_t target_uid = (uid_t)uid_ul;
+
+    char pwbuf[8192];
+    struct passwd pw;
+    struct passwd *result = NULL;
+    if (getpwuid_r(target_uid, &pw, pwbuf, sizeof(pwbuf), &result) != 0 ||
+        result == NULL) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                            _("cannot resolve the user id passed by pkexec"));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+
+    char gbuf[4096];
+    struct group grp;
+    struct group *input_group = NULL;
+    if (getgrnam_r("input", &grp, gbuf, sizeof(gbuf), &input_group) != 0 ||
+        input_group == NULL) {
+        g_set_error_literal(
+            error, G_IO_ERROR, G_IO_ERROR_FAILED,
+            _("the 'input' group does not exist; pkexec elevation is "
+              "unavailable (an active-session udev ACL still works)"));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+
+    /* Build the supplementary group list: the user's regular groups plus
+     * `input`, then give up root for good. */
+    if (initgroups(pw.pw_name, pw.pw_gid) != 0) {
+        g_set_error(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                    _("failed to set up supplementary groups: %s"),
+                    g_strerror(errno));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+
+    gid_t groups[NGROUPS_MAX];
+    int ngroups = getgroups(NGROUPS_MAX, groups);
+    if (ngroups < 0) {
+        g_set_error(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                    _("failed to read supplementary groups: %s"),
+                    g_strerror(errno));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+    gboolean has_input = FALSE;
+    for (int i = 0; i < ngroups; i++) {
+        if (groups[i] == input_group->gr_gid) {
+            has_input = TRUE;
+            break;
+        }
+    }
+    if (!has_input) {
+        if (ngroups >= NGROUPS_MAX) {
+            g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                _("too many supplementary groups"));
+            g_ptr_array_unref(pairs);
+            return FALSE;
+        }
+        groups[ngroups++] = input_group->gr_gid;
+    }
+    if (setgroups((size_t)ngroups, groups) != 0) {
+        g_set_error(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                    _("failed to set supplementary groups: %s"),
+                    g_strerror(errno));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+
+    if (setgid(pw.pw_gid) != 0 || setuid(pw.pw_uid) != 0) {
+        g_set_error(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                    _("failed to drop privileges: %s"), g_strerror(errno));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+    if (getuid() != pw.pw_uid || geteuid() != pw.pw_uid ||
+        getgid() != pw.pw_gid) {
+        g_set_error_literal(error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                            _("privilege drop verification failed"));
+        g_ptr_array_unref(pairs);
+        return FALSE;
+    }
+
+    privilege_dropped = TRUE;
+
+    /* Root is gone — only now is it safe to consume the saved environment
+     * values supplied on the command line. */
+    for (guint i = 0; i < pairs->len; i++) {
+        const char *pair = g_ptr_array_index(pairs, i);
+        const char *eq = strchr(pair, '=');
+        if (eq == NULL) {
+            continue;
+        }
+        char *key = g_strndup(pair, (gsize)(eq - pair));
+        if (seekey_privilege_env_key_allowed(key)) {
+            g_setenv(key, eq + 1, TRUE);
+        }
+        g_free(key);
+    }
+    g_ptr_array_unref(pairs);
+
+    /* pkexec points HOME/USER/LOGNAME at the target user (root) and starts
+     * in that user's home directory; restore the invoking user's values. */
+    g_setenv("HOME", pw.pw_dir, TRUE);
+    g_setenv("USER", pw.pw_name, TRUE);
+    g_setenv("LOGNAME", pw.pw_name, TRUE);
+    if (pw.pw_shell != NULL && pw.pw_shell[0] != '\0') {
+        g_setenv("SHELL", pw.pw_shell, TRUE);
+    }
+
+    /* Best-effort fallback when the caller had no XDG_RUNTIME_DIR (it is
+     * the anchor for the Wayland socket and the session bus). */
+    if (g_getenv("XDG_RUNTIME_DIR") == NULL) {
+        char runtime_dir[64];
+        g_snprintf(runtime_dir, sizeof(runtime_dir), "/run/user/%lu",
+                   (unsigned long)pw.pw_uid);
+        if (g_file_test(runtime_dir, G_FILE_TEST_IS_DIR)) {
+            g_setenv("XDG_RUNTIME_DIR", runtime_dir, TRUE);
+        }
+    }
+
+    int chdir_rc = chdir(pw.pw_dir);
+    if (chdir_rc != 0) {
+        chdir_rc = chdir("/");
+    }
+    (void)chdir_rc;
+    return TRUE;
+}
+
+int seekey_privilege_elevate(int argc, char **argv)
+{
+    if (privilege_dropped || geteuid() == 0) {
+        return -1;
+    }
+
+    char *pkexec = g_find_program_in_path("pkexec");
+    if (pkexec == NULL) {
+        return -1;
+    }
+
+    char *self = g_file_read_link("/proc/self/exe", NULL);
+    if (self == NULL) {
+        self = g_find_program_in_path("seekey");
+    }
+    if (self == NULL) {
+        g_free(pkexec);
+        return -1;
+    }
+
+    GPtrArray *child_argv = g_ptr_array_new_with_free_func(g_free);
+    g_ptr_array_add(child_argv, g_strdup(pkexec));
+    g_ptr_array_add(child_argv, g_strdup(self));
+    for (gsize i = 0; restore_env_keys[i] != NULL; i++) {
+        const char *value = g_getenv(restore_env_keys[i]);
+        if (value != NULL) {
+            g_ptr_array_add(child_argv,
+                            g_strdup_printf(RESTORE_ARG_PREFIX "%s=%s",
+                                            restore_env_keys[i], value));
+        }
+    }
+    for (int i = 1; i < argc; i++) {
+        g_ptr_array_add(child_argv, g_strdup(argv[i]));
+    }
+    g_ptr_array_add(child_argv, NULL);
+
+    g_print(_("seekey: requesting temporary input-group access via "
+              "pkexec\n"));
+
+    GError *spawn_error = NULL;
+    int status = 0;
+    gboolean spawned =
+        g_spawn_sync(NULL, (char **)child_argv->pdata, NULL, 0, NULL, NULL,
+                     NULL, NULL, &status, &spawn_error);
+    g_ptr_array_unref(child_argv);
+    g_free(self);
+    g_free(pkexec);
+
+    if (!spawned) {
+        g_printerr(_("seekey: pkexec failed: %s\n"), spawn_error->message);
+        g_clear_error(&spawn_error);
+        g_printerr(
+            _("seekey: continuing without input-group access\n"));
+        return -1;
+    }
+
+    if (WIFEXITED(status)) {
+        int code = WEXITSTATUS(status);
+        /* pkexec uses 126 (dismissed) and 127 (not authorized / error). */
+        if (code == 126 || code == 127) {
+            g_printerr(_("seekey: pkexec authorization was cancelled or "
+                         "denied; aborting\n"));
+            return -2;
+        }
+        return code;
+    }
+    if (WIFSIGNALED(status)) {
+        g_printerr(_("seekey: pkexec terminated by signal %d; aborting\n"),
+                   WTERMSIG(status));
+        return -2;
+    }
+    return -1;
+}
diff --git a/src/privilege.h b/src/privilege.h
new file mode 100644
index 0000000..594b86d
--- /dev/null
+++ b/src/privilege.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <glib.h>
+
+/* Privilege handling for pkexec-based elevation (see POLKIT.md).
+ *
+ * Two entry points, both called from main():
+ *
+ *  - seekey_privilege_drop_from_pkexec(): runs first.  When the process was
+ *    started through pkexec (euid 0 + PKEXEC_UID), it strips the internal
+ *    --seekey-restore-env arguments, drops back to the invoking user while
+ *    adding only the `input` group, and applies the saved session
+ *    environment afterwards.  Fatal on failure — the process must never
+ *    continue as root.
+ *
+ *  - seekey_privilege_elevate(): called after argument parsing for modes
+ *    that read /dev/input.  When the input group would unlock event nodes
+ *    that are currently unreadable, it re-runs this binary under pkexec and
+ *    waits for it.  Returns the child's exit status (caller should exit
+ *    with it), -2 when authorization was denied or the elevated copy died
+ *    (caller must abort), or -1 when no elevation happened (caller
+ *    continues unprivileged).
+ */
+
+/* TRUE once this process dropped pkexec privileges (or when not launched
+ * through pkexec).  Elevation is never attempted again in that case. */
+gboolean seekey_privilege_elevated(void);
+
+/* If running under pkexec, drop back to the invoking user with the `input`
+ * group added and restore the saved session environment.  Returns FALSE
+ * with @error set when the drop fails (caller must exit).  Returns TRUE
+ * when not launched through pkexec (nothing done). */
+gboolean seekey_privilege_drop_from_pkexec(int *argc, char ***argv,
+                                           GError **error);
+
+/* Try to re-run this program through pkexec with the input group.  Callers
+ * gate on seekey_input_group_access_would_help() first (kept out of here so
+ * this file stays free of input/libevdev dependencies).  Returns -1 when no
+ * elevation happened (caller continues unprivileged), -2 when authorization
+ * was denied or the elevated copy died (caller must abort), otherwise the
+ * elevated copy's exit status. */
+int seekey_privilege_elevate(int argc, char **argv);
+
+/* Testable helpers (also used internally). */
+
+/* TRUE when @key is on the allowlist of environment variables that may be
+ * carried across the pkexec boundary via --seekey-restore-env. */
+gboolean seekey_privilege_env_key_allowed(const char *key);
+
+/* Remove all --seekey-restore-env=KEY=VALUE arguments from @argv (compact
+ * in place, keeping the NULL terminator) and return a newly allocated
+ * GPtrArray of "KEY=VALUE" strings (element free func: g_free). */
+GPtrArray *seekey_privilege_strip_restore_args(int *argc, char ***argv);
