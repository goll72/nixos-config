+        ngroups = getgroups(ngroups, groups);
+        gboolean member = FALSE;
+        for (int i = 0; i < ngroups; i++) {
+            if (groups[i] == input_gid) {
+                member = TRUE;
+                break;
+            }
+        }
+        g_free(groups);
+        if (member) return FALSE;
+    }
+
+    GDir *dir = g_dir_open("/dev/input", 0, NULL);
+    if (dir == NULL) return FALSE;
+
+    gboolean helps = FALSE;
+    const char *name = NULL;
+    while (!helps && (name = g_dir_read_name(dir)) != NULL) {
+        if (!is_event_node_name(name)) continue;
+        char *path = g_build_filename("/dev/input", name, NULL);
+        int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+        if (fd >= 0) {
+            close(fd); /* already readable — no elevation needed */
+        } else {
+            struct stat st;
+            if (stat(path, &st) == 0 && st.st_gid == input_gid &&
+                (st.st_mode & S_IRGRP)) {
+                helps = TRUE;
+            }
+        }
+        g_free(path);
+    }
+    g_dir_close(dir);
+    return helps;
+}
