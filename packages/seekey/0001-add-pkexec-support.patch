+static char *g_runtime_dir = NULL;
+
+static void isolate_runtime_dir(void)
+{
+    GError *err = NULL;
+    g_runtime_dir = g_dir_make_tmp("seekey-test-runtime-XXXXXX", &err);
+    if (g_runtime_dir == NULL) {
+        g_error("isolate_runtime_dir failed: %s", err->message);
+    }
+    g_setenv("XDG_RUNTIME_DIR", g_runtime_dir, TRUE);
+}
+
+static void cleanup_runtime_dir(void)
+{
+    if (g_runtime_dir == NULL) {
+        return;
+    }
+    GDir *dir = g_dir_open(g_runtime_dir, 0, NULL);
+    if (dir != NULL) {
+        const char *name;
+        while ((name = g_dir_read_name(dir)) != NULL) {
+            char *path = g_build_filename(g_runtime_dir, name, NULL);
+            g_unlink(path);
+            g_free(path);
+        }
+        g_dir_close(dir);
+    }
+    g_rmdir(g_runtime_dir);
+    g_free(g_runtime_dir);
+    g_runtime_dir = NULL;
+}
 
