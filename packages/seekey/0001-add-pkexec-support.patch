@@ -85,6 +87,11 @@ Seekey 会在热插拔或权限变化后继续重试。
 ./install.sh --uninstall    # 卸载
 ```
 
+输入权限默认通过 udev/logind ACL 授予，`--input-group` 是永久回退方案。
+安装脚本还会注册一条 polkit 策略：两者都不可用时，Seekey 会请求一次
+`pkexec` 认证，以 `input` 用户组身份运行本次会话——它启动的设置菜单、
+实时预览和浮层都会直接继承该权限，不再重复认证。
+
 安装时还会创建 Seekey 桌面入口。第一次从应用菜单启动时，可以选择以后
 默认打开设置菜单，或直接启动按键浮层。`seekey --config-gui` 始终会打开设置。
 
diff --git a/data/dev.seekey.policy b/data/dev.seekey.policy
new file mode 100644
index 0000000..932415b
--- /dev/null
+++ b/data/dev.seekey.policy
@@ -0,0 +1,31 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE policyconfig PUBLIC
+ "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
+<policyconfig>
+  <vendor>Seekey</vendor>
+  <vendor_url>https://github.com/Nakanomk/Seekey</vendor_url>
+
+  <!--
+    Authorizes `pkexec <bindir>/seekey`.  Seekey uses this only to add the
+    invoking user to the `input` group for the lifetime of one process; it
+    drops back to the invoking user immediately after startup.
+
+    The bindir placeholder is replaced with the real bindir at install
+    time, because pkexec matches the org.freedesktop.policykit.exec.path
+    annotation against the realpath of the program being executed.
+  -->
+  <action id="dev.seekey.run">
+    <description>Run Seekey with access to input devices</description>
+    <description xml:lang="zh_CN">运行 Seekey 并允许访问输入设备</description>
+    <message>Authentication is required to run Seekey with access to input devices</message>
+    <message xml:lang="zh_CN">运行 Seekey 并访问输入设备需要进行身份认证</message>
+    <icon_name>input-keyboard-symbolic</icon_name>
+    <defaults>
+      <allow_any>no</allow_any>
+      <allow_inactive>auth_admin</allow_inactive>
+      <allow_active>auth_admin</allow_active>
+    </defaults>
+    <annotate key="org.freedesktop.policykit.exec.path">@BINDIR@/seekey</annotate>
+  </action>
+</policyconfig>
diff --git a/install.sh b/install.sh
index 2643ca2..ba30b91 100755
--- a/install.sh
+++ b/install.sh
@@ -9,6 +9,8 @@
 #   4. Install the example config and desktop application entry.
 #   5. Install a udev rule that grants the active local session access to
 #      /dev/input/event*; persistent `input` group access is opt-in fallback.
+#   6. Install a polkit policy so seekey can request temporary `input` group
+#      access through pkexec when no other access method works.
 #
 # It does NOT install autostart entries; see the wiki (Autostart page) for
 # compositor-specific startup instructions.
@@ -54,6 +56,8 @@ After install:
   - Run 'seekey --config-tui' to edit settings
   - Active local sessions get input access through a udev/logind ACL
   - If that is unavailable, rerun with --input-group and log out/in
+  - Without either, seekey offers a one-time pkexec (polkit) prompt for
+    temporary input-group access; the policy is installed system-wide
 EOF
 }
 
@@ -93,6 +97,10 @@ CURRENT_USER="${SUDO_USER:-${USER:-$(id -un)}}"
 RUNNING_USER="$(id -un)"
 UDEV_RULE_PATH="/etc/udev/rules.d/70-seekey-input.rules"
 LEGACY_UDEV_RULE_PATH="/etc/udev/rules.d/99-seekey.rules"
+# polkitd only reads actions from the system data dirs, never ~/.local/share,
+# so the policy is installed system-wide even for --user installs.
+POLKIT_ACTIONS_DIR="/usr/local/share/polkit-1/actions"
+POLKIT_POLICY_PATH="${POLKIT_ACTIONS_DIR}/dev.seekey.policy"
 
 # ---------- Logging helpers --------------------------------------------
 
@@ -276,6 +284,7 @@ do_uninstall() {
         run "${INSTALL_CMD[@]}" rm -f "${mo}"
     done
     if $SETUP_INPUT; then
+        remove_polkit_policy
         remove_udev_rules
     fi
     ok "Uninstalled binary and data files"
@@ -290,6 +299,11 @@ is_seekey_udev_rule() {
     [[ -f "${path}" ]] && grep -q '^# [Ss]eekey:' "${path}"
 }
 
+is_seekey_policy() {
+    local path="$1"
+    [[ -f "${path}" ]] && grep -q 'id="dev.seekey.run"' "${path}"
+}
+
 reload_input_udev_rules() {
     run "${ROOT_CMD[@]}" udevadm control --reload-rules
     run "${ROOT_CMD[@]}" udevadm trigger --subsystem-match=input
@@ -330,6 +344,32 @@ install_udev_rule() {
     reload_input_udev_rules
 }
 
+# Installs the polkit policy that lets 'pkexec <bindir>/seekey' request
+# temporary input-group access (see POLKIT.md).  The @BINDIR@ placeholder is
+# replaced with the real bindir because pkexec matches the policy annotation
+# against the realpath of the executed program.
+install_polkit_policy() {
+    require_root_tool
+    local source_path="${SCRIPT_DIR}/data/dev.seekey.policy"
+    [[ -f "${source_path}" ]] || die "Missing polkit policy: ${source_path}"
+
+    local tmp
+    tmp="$(mktemp)"
+    sed "s|@BINDIR@|${BINDIR}|g" "${source_path}" > "${tmp}"
+    log "Installing polkit policy to ${POLKIT_POLICY_PATH}"
+    run "${ROOT_CMD[@]}" install -Dm644 "${tmp}" "${POLKIT_POLICY_PATH}"
+    rm -f "${tmp}"
+}
+
+remove_polkit_policy() {
+    if ! is_seekey_policy "${POLKIT_POLICY_PATH}"; then
+        return
+    fi
+    require_root_tool
+    log "Removing Seekey polkit policy ${POLKIT_POLICY_PATH}"
+    run "${ROOT_CMD[@]}" rm -f "${POLKIT_POLICY_PATH}"
+}
+
 user_can_read_input_event() {
     local path="$1"
     if [[ "${RUNNING_USER}" == "${CURRENT_USER}" ]]; then
@@ -447,6 +487,7 @@ build_seekey
 install_files
 
 if $SETUP_INPUT; then
+    install_polkit_policy
     install_udev_rule
     setup_input_access
 fi
