diff --git a/tests/test_privilege.c b/tests/test_privilege.c
new file mode 100644
index 0000000..86e9145
--- /dev/null
+++ b/tests/test_privilege.c
@@ -0,0 +1,101 @@
+#include "unity.h"
+
+#include "privilege.h"
+
+#include <glib.h>
+#include <string.h>
+
+static void test_env_key_allowlist(void) {
+  TEST_ASSERT_TRUE(seekey_privilege_env_key_allowed("WAYLAND_DISPLAY"));
+  TEST_ASSERT_TRUE(seekey_privilege_env_key_allowed("XDG_RUNTIME_DIR"));
+  TEST_ASSERT_TRUE(
+      seekey_privilege_env_key_allowed("DBUS_SESSION_BUS_ADDRESS"));
+  TEST_ASSERT_TRUE(seekey_privilege_env_key_allowed("XDG_CONFIG_HOME"));
+  TEST_ASSERT_TRUE(seekey_privilege_env_key_allowed("TERM"));
+
+  TEST_ASSERT_FALSE(seekey_privilege_env_key_allowed("LD_PRELOAD"));
+  TEST_ASSERT_FALSE(seekey_privilege_env_key_allowed("LD_LIBRARY_PATH"));
+  TEST_ASSERT_FALSE(seekey_privilege_env_key_allowed("PATH"));
+  TEST_ASSERT_FALSE(seekey_privilege_env_key_allowed("HOME"));
+  TEST_ASSERT_FALSE(seekey_privilege_env_key_allowed("PKEXEC_UID"));
+  TEST_ASSERT_FALSE(seekey_privilege_env_key_allowed(NULL));
+}
+
+static void test_strip_restore_args(void) {
+  char arg0[] = "seekey";
+  char arg1[] = "--seekey-restore-env=WAYLAND_DISPLAY=wayland-0";
+  char arg2[] = "--config-gui";
+  char arg3[] =
+      "--seekey-restore-env=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus";
+  char arg4[] = "--duration";
+  char arg5[] = "500";
+  char *argv_storage[] = {arg0, arg1, arg2, arg3, arg4, arg5};
+  char **argv = argv_storage;
+  int argc = 6;
+
+  GPtrArray *pairs = seekey_privilege_strip_restore_args(&argc, &argv);
+  TEST_ASSERT_NOT_NULL(pairs);
+
+  /* Restore args are gone, everything else keeps its order. */
+  TEST_ASSERT_EQUAL_INT(4, argc);
+  TEST_ASSERT_EQUAL_STRING("seekey", argv[0]);
+  TEST_ASSERT_EQUAL_STRING("--config-gui", argv[1]);
+  TEST_ASSERT_EQUAL_STRING("--duration", argv[2]);
+  TEST_ASSERT_EQUAL_STRING("500", argv[3]);
+  TEST_ASSERT_NULL(argv[4]);
+
+  /* Values keep embedded '=' (e.g. D-Bus addresses). */
+  TEST_ASSERT_EQUAL_UINT(2, pairs->len);
+  TEST_ASSERT_EQUAL_STRING("WAYLAND_DISPLAY=wayland-0",
+                           (char *)g_ptr_array_index(pairs, 0));
+  TEST_ASSERT_EQUAL_STRING(
+      "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus",
+      (char *)g_ptr_array_index(pairs, 1));
+
+  g_ptr_array_unref(pairs);
+}
+
+static void test_strip_restore_args_skips_malformed(void) {
+  char arg0[] = "seekey";
+  char arg1[] = "--seekey-restore-env=";
+  char arg2[] = "--seekey-restore-env=NOEQUALS";
+  char arg3[] = "--debug-input";
+  char *argv_storage[] = {arg0, arg1, arg2, arg3};
+  char **argv = argv_storage;
+  int argc = 4;
+
+  GPtrArray *pairs = seekey_privilege_strip_restore_args(&argc, &argv);
+
+  /* Malformed entries are dropped rather than left for the option parser,
+   * and no pair is collected from them. */
+  TEST_ASSERT_EQUAL_INT(2, argc);
+  TEST_ASSERT_EQUAL_STRING("seekey", argv[0]);
+  TEST_ASSERT_EQUAL_STRING("--debug-input", argv[1]);
+  TEST_ASSERT_NULL(argv[2]);
+  TEST_ASSERT_EQUAL_UINT(0, pairs->len);
+
+  g_ptr_array_unref(pairs);
+}
+
+static void test_strip_restore_args_without_matches(void) {
+  char arg0[] = "seekey";
+  char arg1[] = "--print-config";
+  char *argv_storage[] = {arg0, arg1};
+  char **argv = argv_storage;
+  int argc = 2;
+
+  GPtrArray *pairs = seekey_privilege_strip_restore_args(&argc, &argv);
+  TEST_ASSERT_EQUAL_INT(2, argc);
+  TEST_ASSERT_EQUAL_STRING("--print-config", argv[1]);
+  TEST_ASSERT_EQUAL_UINT(0, pairs->len);
+  g_ptr_array_unref(pairs);
+}
+
+int run_privilege_tests(void) {
+  UNITY_BEGIN();
+  RUN_TEST(test_env_key_allowlist);
+  RUN_TEST(test_strip_restore_args);
+  RUN_TEST(test_strip_restore_args_skips_malformed);
+  RUN_TEST(test_strip_restore_args_without_matches);
+  return UNITY_END();
+}
